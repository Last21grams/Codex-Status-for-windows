param([switch]$Probe)

Add-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase, System.Xaml

# Keep exactly one widget instance. This also prevents an old shortcut launch
# from leaving several differently-colored widgets stacked on the desktop.
$createdNew = $false
$instanceMutex = [Threading.Mutex]::new($true, 'Local\CodexStatusWidget_9C9A89F2', [ref]$createdNew)
if (!$createdNew) { exit 0 }

$xaml = @'
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Status" Width="316" Height="46" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize">
  <Border CornerRadius="12" Background="#EE171A20" BorderBrush="#443D4655" BorderThickness="1" Padding="10,5">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#000000"/></Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="38"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Ellipse x:Name="Glow" Width="27" Height="27" Fill="#31363F" Opacity="0.55"/>
        <Ellipse x:Name="Lamp" Width="17" Height="17" Fill="#46D67C" Stroke="#99FFFFFF" StrokeThickness="1"/>
      </Grid>

      <Border Grid.Column="1" Background="#3AFFFFFF" Margin="0,3"/>

      <Grid Grid.Column="2" Margin="10,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
          <TextBlock Text="5h" Foreground="#C9CDD6" FontSize="11" VerticalAlignment="Center"/>
          <ProgressBar x:Name="FiveBar" Grid.Column="1" Height="5" Minimum="0" Maximum="100" Value="0"
                       Foreground="#58A6FF" Background="#343943" BorderThickness="0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="FiveText" Text="--%" Foreground="White" FontSize="10" TextAlignment="Right"/>
            <TextBlock x:Name="FiveResetText" Text="--:--" Foreground="#7F8793" FontSize="8" TextAlignment="Right"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Column="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="43"/></Grid.ColumnDefinitions>
          <TextBlock Text="&#21608;" Foreground="#C9CDD6" FontSize="11" VerticalAlignment="Center"/>
          <ProgressBar x:Name="WeekBar" Grid.Column="1" Height="5" Minimum="0" Maximum="100" Value="0"
                       Foreground="#A78BFA" Background="#343943" BorderThickness="0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="WeekText" Text="--%" Foreground="White" FontSize="10" TextAlignment="Right"/>
            <TextBlock x:Name="WeekResetText" Text="--" Foreground="#7F8793" FontSize="8" TextAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
'@

$reader = [System.Xml.XmlNodeReader]::new([xml]$xaml)
$window = [Windows.Markup.XamlReader]::Load($reader)
$lamp = $window.FindName('Lamp'); $glow = $window.FindName('Glow')
$fiveBar = $window.FindName('FiveBar'); $weekBar = $window.FindName('WeekBar')
$fiveText = $window.FindName('FiveText'); $weekText = $window.FindName('WeekText')
$fiveResetText = $window.FindName('FiveResetText'); $weekResetText = $window.FindName('WeekResetText')

function New-Brush([string]$color) {
    return [Windows.Media.SolidColorBrush]([Windows.Media.ColorConverter]::ConvertFromString($color))
}

function Set-Lamp([string]$state, [string]$detail) {
    $colors = @{ idle='#42D77D'; running='#F6C445'; action='#4BA3FF'; offline='#77808D' }
    $labels = @{ idle='Idle'; running='Running'; action='Action needed'; offline='Codex not found' }
    $color = $colors[$state]
    $lamp.Fill = New-Brush $color
    $glow.Fill = New-Brush $color
    $glow.Opacity = if ($state -eq 'offline') { 0.15 } else { 0.34 }
}

function Get-RecentSessionFiles {
    $root = Join-Path $env:USERPROFILE '.codex\sessions'
    if (!(Test-Path $root)) { return @() }
    return @(Get-ChildItem $root -Recurse -File -Filter '*.jsonl' -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending | Select-Object -First 12)
}

function Get-CodexSnapshot {
    $files = @(Get-RecentSessionFiles)
    if ($files.Count -eq 0) { return @{ State='offline'; Detail='No local sessions found'; Five=$null; Week=$null; FiveReset=$null; WeekReset=$null } }

    $latestRate = $null
    $newestEvent = [datetime]::MinValue
    $newestKind = ''
    $latestTurnStart = [datetime]::MinValue
    $latestFinal = [datetime]::MinValue
    $pending = @{}

    foreach ($file in $files) {
        $lines = @(Get-Content -LiteralPath $file.FullName -Tail 450 -ErrorAction SilentlyContinue)
        foreach ($line in $lines) {
            try { $item = $line | ConvertFrom-Json -ErrorAction Stop } catch { continue }
            try { $when = [datetime]::Parse($item.timestamp).ToLocalTime() } catch { $when = $file.LastWriteTime }

            # A new turn or a final assistant message closes any stale request
            # left behind by an interrupted/rejected tool call in this session.
            if ($item.type -eq 'turn_context') {
                $pending.Clear()
                if ($when -gt $latestTurnStart) { $latestTurnStart = $when }
            }
            if ($item.type -eq 'response_item' -and $item.payload.type -eq 'message' -and
                $item.payload.role -eq 'assistant' -and $item.payload.phase -eq 'final') {
                $pending.Clear()
                if ($when -gt $latestFinal) { $latestFinal = $when }
            }
            if ($when -gt $newestEvent) {
                $newestEvent = $when
                if ($item.type -eq 'turn_context') {
                    $newestKind = 'turn_context'
                } elseif ($item.type -eq 'response_item') {
                    $newestKind = [string]$item.payload.type
                    if ($item.payload.type -eq 'message' -and $item.payload.role -eq 'assistant') {
                        if ($item.payload.phase -eq 'final') { $newestKind = 'final_message' }
                        elseif ($item.payload.phase -eq 'commentary') { $newestKind = 'commentary_message' }
                    }
                }
                elseif ($item.type -eq 'event_msg') { $newestKind = [string]$item.payload.type }
            }

            if ($item.type -eq 'event_msg' -and $item.payload.type -eq 'token_count' -and $item.payload.rate_limits) {
                if (!$latestRate -or $when -gt $latestRate.When) {
                    $latestRate = @{ When=$when; Data=$item.payload.rate_limits }
                }
            }
            if ($item.type -eq 'response_item' -and $item.payload.type -eq 'custom_tool_call') {
                $id = [string]$item.payload.call_id
                if ($id) {
                    $raw = [string]$item.payload.input
                    # Match an actual escalation argument, not diagnostic text that
                    # merely contains the words sandbox_permissions/require_escalated.
                    $actualEscalation = $raw -match 'sandbox_permissions\\?["'']?\s*:\s*\\?["'']require_escalated'
                    $needsAction = ($item.payload.name -eq 'request_user_input') -or $actualEscalation
                    $pending[$id] = @{ When=$when; Action=$needsAction; Name=[string]$item.payload.name }
                }
            }
            if ($item.type -eq 'response_item' -and $item.payload.type -eq 'custom_tool_call_output') {
                $id = [string]$item.payload.call_id
                if ($pending.ContainsKey($id)) { $pending.Remove($id) }
            }
        }
    }

    $state = 'idle'; $detail = "Last activity: $($newestEvent.ToString('HH:mm:ss'))"
    $activePending = @($pending.Values | Where-Object { $_.When -gt (Get-Date).AddHours(-6) } | Sort-Object When -Descending)
    if (($latestFinal -ge $latestTurnStart -and $latestFinal -ne [datetime]::MinValue) -or $newestKind -eq 'turn_aborted') {
        $state = 'idle'; $detail = 'Response finished'
    } elseif (@($activePending | Where-Object Action).Count -gt 0) {
        $state = 'action'; $detail = 'Waiting for approval or a choice'
    } elseif ($activePending.Count -gt 0) {
        $state = 'running'; $detail = 'Running a tool'
    } elseif (((Get-Date) - $newestEvent).TotalSeconds -lt 12) {
        $state = 'running'; $detail = 'Thinking or generating a response'
    }

    $five = $null; $week = $null; $fiveReset = $null; $weekReset = $null
    if ($latestRate) {
        if ($latestRate.Data.primary) {
            $five = [math]::Max(0, 100 - [double]$latestRate.Data.primary.used_percent)
            if ($latestRate.Data.primary.resets_at) {
                $fiveReset = [DateTimeOffset]::FromUnixTimeSeconds([long]$latestRate.Data.primary.resets_at).LocalDateTime
            }
        }
        if ($latestRate.Data.secondary) {
            $week = [math]::Max(0, 100 - [double]$latestRate.Data.secondary.used_percent)
            if ($latestRate.Data.secondary.resets_at) {
                $weekReset = [DateTimeOffset]::FromUnixTimeSeconds([long]$latestRate.Data.secondary.resets_at).LocalDateTime
            }
        }
    }
    return @{ State=$state; Detail=$detail; Five=$five; Week=$week; FiveReset=$fiveReset; WeekReset=$weekReset }
}

function Update-Widget {
    $s = Get-CodexSnapshot
    Set-Lamp $s.State $s.Detail
    # Codex Desktop commits its visible quota after a turn finishes. Keep the
    # previous confirmed value while a turn is running to avoid 2-3% flicker.
    $refreshUsage = ($s.State -eq 'idle') -or ($fiveText.Text -eq '--%')
    if ($refreshUsage -and $null -ne $s.Five) {
        $fiveBar.Value=$s.Five
        $fiveBar.Foreground = New-Brush $(if ($s.Five -lt 20) { '#F05252' } else { '#58A6FF' })
        $fiveText.Text=('{0:0}%' -f $s.Five)
        if ($s.FiveReset) { $fiveResetText.Text=$s.FiveReset.ToString('HH:mm') }
    }
    if ($refreshUsage -and $null -ne $s.Week) {
        $weekBar.Value=$s.Week
        $weekBar.Foreground = New-Brush $(if ($s.Week -lt 20) { '#F05252' } else { '#A78BFA' })
        $weekText.Text=('{0:0}%' -f $s.Week)
        if ($s.WeekReset) {
            $weekResetText.Text = $s.WeekReset.Month.ToString() + [char]0x6708 + $s.WeekReset.Day.ToString() + [char]0x65E5
        }
    }
}

if ($Probe) {
    Get-CodexSnapshot | ConvertTo-Json -Compress
    exit 0
}

$window.Add_MouseLeftButtonDown({
    if ($args[1].ClickCount -ge 2) { $window.Close(); return }
    try { $window.DragMove() } catch {}
})
$window.Add_MouseRightButtonUp({ $window.Topmost = !$window.Topmost })

$workArea = [System.Windows.SystemParameters]::WorkArea
$window.Left = $workArea.Right - $window.Width - 18
$window.Top = $workArea.Bottom - $window.Height - 18

$timer = [Windows.Threading.DispatcherTimer]::new()
$timer.Interval = [TimeSpan]::FromSeconds(2)
$timer.Add_Tick({ Update-Widget })
$window.Add_Loaded({ Update-Widget; $timer.Start() })
$window.Add_Closed({
    $timer.Stop()
    try { $instanceMutex.ReleaseMutex() } catch {}
    $instanceMutex.Dispose()
})

[void]$window.ShowDialog()
